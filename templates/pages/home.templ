package pages

import (
	"rowetech/internal/meta"
	"rowetech/templates/layouts"
)

templ Home() {
	@layouts.Base(meta.New("Home", "Precision machining, mold repair, and custom tooling solutions for manufacturers across Wisconsin.")) {
		<!-- Hero -->
		<section class="relative min-h-[100svh] flex items-center overflow-hidden">
			<div class="absolute inset-0 bg-secondary-950"></div>
			<img src="https://images.unsplash.com/photo-1504328345606-18bbc8c9d7d1?w=1920&q=80" alt="Industrial manufacturing" class="absolute inset-0 w-full h-full object-cover"/>
			<div class="absolute inset-0 bg-secondary-950/40"></div>

			<div class="container-custom relative z-10 text-center">
				<h1 class="mb-6">
					<span class="hero-title block">Industrial</span>
					<span class="hero-title-accent block">Precision</span>
				</h1>
				<p class="text-base md:text-lg text-white/80 max-w-xl mx-auto mb-10">
					Mold repair, custom fixtures, EOAT tooling, and CNC machining for manufacturers who demand precision.
				</p>
				<div class="flex flex-wrap gap-4 justify-center">
					<a href="/contact" class="btn-primary text-sm md:text-base px-8 py-4">
						Request Quote
					</a>
					<a href="tel:+17152023631" class="btn-primary text-sm md:text-base px-8 py-4">
						<svg class="mr-2 w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
						</svg>
						(715) 202-3631
					</a>
				</div>
			</div>
		</section>

		<!-- Services -->
		<section class="py-24 lg:py-32 bg-secondary-950">
			<div class="container-custom">
				<div class="max-w-4xl mx-auto">
					<div class="text-center mb-16">
						<h2 class="font-display text-3xl md:text-5xl text-white uppercase mb-4">What We Do</h2>
						<p class="text-secondary-300 text-base md:text-lg max-w-xl mx-auto">
							Comprehensive machining and tooling solutions for plastic injection molding and manufacturing.
						</p>
					</div>
					<div class="grid md:grid-cols-2 gap-x-16 gap-y-12">
						@serviceLink("Mold Repair", "Expert mold repair and maintenance to minimize your downtime.", "/services#mold-repair")
						@serviceLink("Custom Fixtures", "Precision workholding and assembly fixtures for production.", "/services#fixtures")
						@serviceLink("EOAT Tooling", "End-of-arm tooling for automation and robotics systems.", "/services#eoat")
						@serviceLink("CNC Machining", "High-precision milling and turning for complex parts.", "/services#cnc")
					</div>
					<div class="text-center mt-16">
						<a href="/services" class="btn-outline">View All Services</a>
					</div>
				</div>
			</div>
		</section>

		<!-- CTA -->
		<section class="relative min-h-[60vh] flex items-center overflow-hidden">
			<img src="https://images.unsplash.com/photo-1504917595217-d4dc5ebe6122?w=1920&q=80" alt="" class="absolute inset-0 w-full h-full object-cover"/>
			<div class="absolute inset-0 bg-secondary-950/50"></div>
			<div class="container-custom relative z-10 text-center">
				<h2 class="font-display text-4xl md:text-6xl text-white uppercase mb-6">Ready to Build?</h2>
				<p class="text-white/70 text-base md:text-lg mb-8 max-w-xl mx-auto">
					Contact us for a quote. We respond within 48 hours.
				</p>
				<div class="flex flex-col sm:flex-row gap-4 justify-center">
					<a href="/contact" class="btn-primary text-sm md:text-base px-10 py-5">Request a Quote</a>
					<a href="tel:+17152023631" class="btn-primary text-sm md:text-base px-10 py-5">Call (715) 202-3631</a>
				</div>
			</div>
		</section>
	}
}

templ serviceLink(title, description, href string) {
	<a href={ templ.SafeURL(href) } class="group block">
		<h3 class="font-display text-xl md:text-2xl uppercase tracking-wide text-white mb-2 group-hover:text-primary-400 transition-colors">
			{ title }
		</h3>
		<p class="text-secondary-300 text-sm md:text-base mb-3">{ description }</p>
		<span class="text-primary-400 font-semibold uppercase tracking-wider text-xs inline-flex items-center group-hover:text-primary-300 transition-colors">
			Learn More
			<svg class="w-3 h-3 ml-1.5 group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
				<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
			</svg>
		</span>
	</a>
}
