package pages

import (
	"rowetech/internal/meta"
	"rowetech/templates/layouts"
)

templ Home() {
	@layouts.Base(meta.New("Home", "Precision machining, mold repair, and custom tooling solutions for manufacturers across Wisconsin.")) {
		<!-- Hero -->
		<section class="relative min-h-[100svh] flex items-center overflow-hidden">
			<div class="absolute inset-0 bg-secondary-950"></div>
			<img src="https://images.unsplash.com/photo-1504328345606-18bbc8c9d7d1?w=1920&q=80" alt="Industrial manufacturing" class="absolute inset-0 w-full h-full object-cover"/>
			<div class="absolute inset-0 bg-secondary-950/40"></div>

			<div class="container-custom relative z-10 text-center">
				<h1 class="mb-6">
					<span class="hero-title block">Industrial</span>
					<span class="hero-title-accent block">Precision</span>
				</h1>
				<p class="text-base md:text-lg text-white/80 max-w-xl mx-auto mb-10">
					Mold repair, custom fixtures, EOAT tooling, and CNC machining for manufacturers who demand precision.
				</p>
				<div class="flex flex-wrap gap-4 justify-center">
					<a href="/contact" class="btn-primary text-sm md:text-base px-8 py-4">
						Request Quote
					</a>
					<a href="tel:+17152023631" class="btn-primary text-sm md:text-base px-8 py-4">
						<svg class="mr-2 w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
						</svg>
						(715) 202-3631
					</a>
				</div>
			</div>
		</section>

		<!-- Mold Repair -->
		<section class="relative min-h-[80vh] md:min-h-[90vh] flex items-end overflow-hidden">
			<img src="https://images.unsplash.com/photo-1504328345606-18bbc8c9d7d1?w=1920&q=80" alt="Mold Repair" class="absolute inset-0 w-full h-full object-cover"/>
			<div class="absolute inset-0 bg-gradient-to-t from-secondary-950/80 via-secondary-950/20 to-transparent"></div>
			<div class="relative z-10 container-custom pb-16 md:pb-24">
				<h2 class="font-display text-3xl md:text-5xl lg:text-6xl text-white uppercase tracking-wide mb-3">Mold Repair</h2>
				<p class="text-white/70 text-sm md:text-base max-w-lg mb-6">Expert plastic injection mold repair and maintenance to minimize your downtime.</p>
				<a href="/services#mold-repair" class="text-primary-400 font-semibold uppercase tracking-wider text-sm inline-flex items-center hover:text-primary-300 transition-colors">
					Learn More
					<svg class="w-4 h-4 ml-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
					</svg>
				</a>
			</div>
		</section>

		<!-- Custom Fixtures -->
		<section class="relative min-h-[80vh] md:min-h-[90vh] flex items-end overflow-hidden">
			<img src="https://images.unsplash.com/photo-1581092918056-0c4c3acd3789?w=1920&q=80" alt="Custom Fixtures" class="absolute inset-0 w-full h-full object-cover"/>
			<div class="absolute inset-0 bg-gradient-to-t from-secondary-950/80 via-secondary-950/20 to-transparent"></div>
			<div class="relative z-10 container-custom pb-16 md:pb-24">
				<h2 class="font-display text-3xl md:text-5xl lg:text-6xl text-white uppercase tracking-wide mb-3">Custom Fixtures</h2>
				<p class="text-white/70 text-sm md:text-base max-w-lg mb-6">Precision-engineered workholding and assembly fixtures for your production needs.</p>
				<a href="/services#fixtures" class="text-primary-400 font-semibold uppercase tracking-wider text-sm inline-flex items-center hover:text-primary-300 transition-colors">
					Learn More
					<svg class="w-4 h-4 ml-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
					</svg>
				</a>
			</div>
		</section>

		<!-- EOAT Tooling -->
		<section class="relative min-h-[80vh] md:min-h-[90vh] flex items-end overflow-hidden">
			<img src="https://images.unsplash.com/photo-1565193566173-7a0ee3dbe261?w=1920&q=80" alt="EOAT Tooling" class="absolute inset-0 w-full h-full object-cover"/>
			<div class="absolute inset-0 bg-gradient-to-t from-secondary-950/80 via-secondary-950/20 to-transparent"></div>
			<div class="relative z-10 container-custom pb-16 md:pb-24">
				<h2 class="font-display text-3xl md:text-5xl lg:text-6xl text-white uppercase tracking-wide mb-3">EOAT Tooling</h2>
				<p class="text-white/70 text-sm md:text-base max-w-lg mb-6">End-of-arm tooling designed for automation and robotics systems.</p>
				<a href="/services#eoat" class="text-primary-400 font-semibold uppercase tracking-wider text-sm inline-flex items-center hover:text-primary-300 transition-colors">
					Learn More
					<svg class="w-4 h-4 ml-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
					</svg>
				</a>
			</div>
		</section>

		<!-- CNC Machining -->
		<section class="relative min-h-[80vh] md:min-h-[90vh] flex items-end overflow-hidden">
			<img src="https://images.unsplash.com/photo-1504917595217-d4dc5ebe6122?w=1920&q=80" alt="CNC Machining" class="absolute inset-0 w-full h-full object-cover"/>
			<div class="absolute inset-0 bg-gradient-to-t from-secondary-950/80 via-secondary-950/20 to-transparent"></div>
			<div class="relative z-10 container-custom pb-16 md:pb-24">
				<h2 class="font-display text-3xl md:text-5xl lg:text-6xl text-white uppercase tracking-wide mb-3">CNC Machining</h2>
				<p class="text-white/70 text-sm md:text-base max-w-lg mb-6">High-precision CNC milling and turning for complex parts and production runs.</p>
				<a href="/services#cnc" class="text-primary-400 font-semibold uppercase tracking-wider text-sm inline-flex items-center hover:text-primary-300 transition-colors">
					Learn More
					<svg class="w-4 h-4 ml-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
					</svg>
				</a>
			</div>
		</section>

		<!-- CTA -->
		<section class="relative min-h-[60vh] flex items-center overflow-hidden">
			<img src="https://images.unsplash.com/photo-1504328345606-18bbc8c9d7d1?w=1920&q=80" alt="" class="absolute inset-0 w-full h-full object-cover"/>
			<div class="absolute inset-0 bg-secondary-950/50"></div>
			<div class="container-custom relative z-10 text-center">
				<h2 class="font-display text-4xl md:text-6xl text-white uppercase mb-6">Ready to Build?</h2>
				<p class="text-white/70 text-base md:text-lg mb-8 max-w-xl mx-auto">
					Contact us for a quote. We respond within 48 hours.
				</p>
				<div class="flex flex-col sm:flex-row gap-4 justify-center">
					<a href="/contact" class="btn-primary text-sm md:text-base px-10 py-5">Request a Quote</a>
					<a href="tel:+17152023631" class="btn-primary text-sm md:text-base px-10 py-5">Call (715) 202-3631</a>
				</div>
			</div>
		</section>
	}
}
