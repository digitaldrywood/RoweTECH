package pages

import (
	"rowetech/internal/meta"
	"rowetech/templates/layouts"
)

templ Capabilities(content map[string]string) {
	@layouts.Base(meta.New("Capabilities", "Equipment, materials, and tolerances for RoweTech machining services.")) {
		<!-- Hero -->
		<section class="relative min-h-[88svh] flex items-center overflow-hidden">
			<div class="absolute inset-0">
				<img src="/static/images/customer/cmm-inspection-room.jpg" alt="CMM inspection equipment" class="w-full h-full object-cover"/>
				<div class="absolute inset-0 bg-secondary-950/52"></div>
				<div class="absolute inset-0 bg-[radial-gradient(circle_at_top,rgba(255,255,255,0.16),transparent_42%),linear-gradient(180deg,rgba(14,18,19,0.18),rgba(14,18,19,0.72))]"></div>
			</div>
			<div class="container-custom relative z-10 text-center">
				<span class="inline-flex items-center rounded-full border border-white/20 bg-white/10 px-5 py-2 text-[0.7rem] font-semibold uppercase tracking-[0.28em] text-white/80 backdrop-blur-sm">{ content["capabilities.hero.badge"] }</span>
				<h1 class="font-display text-5xl md:text-7xl lg:text-[5.5rem] text-white uppercase mt-6 mb-6">{ content["capabilities.hero.title"] }</h1>
				<p class="text-lg md:text-xl lg:text-2xl text-white/82 max-w-3xl mx-auto leading-relaxed">
					{ content["capabilities.hero.body"] }
				</p>
			</div>
		</section>

		<div class="capabilities-page-surface relative overflow-hidden">
			<div class="absolute inset-x-0 top-0 h-40 bg-[linear-gradient(180deg,rgba(245,241,235,0.2),transparent)]"></div>
			<div class="absolute inset-0 industrial-grid opacity-25"></div>
			<div class="relative">
				<!-- Equipment -->
				<section class="py-20 lg:py-24">
					<div class="container-custom">
						<div class="text-center mb-14 lg:mb-16">
							<span class="text-primary-500 font-semibold tracking-[0.2em] uppercase text-sm">{ content["capabilities.equipment.eyebrow"] }</span>
							<h2 class="section-heading capabilities-section-heading mt-4">{ content["capabilities.equipment.heading"] }</h2>
							<p class="mx-auto mt-6 max-w-3xl text-base md:text-lg text-secondary-700 leading-relaxed">
								{ content["capabilities.equipment.body"] }
							</p>
						</div>
						<div class="grid md:grid-cols-2 xl:grid-cols-4 gap-5 lg:gap-6">
							@capabilityCard("CNC Milling", []string{"Vertical machining centers", "3-axis capability", "Multi-axis options"})
							@capabilityCard("CNC Turning", []string{"CNC lathes", "Live tooling", "Mill-turn capability"})
							@capabilityCard("Surface Finishing", []string{"Surface grinding", "Polishing", "Mold finishing"})
							@capabilityCard("EDM", []string{"Wire EDM", "Sinker EDM", "Complex cavity machining"})
						</div>
					</div>
				</section>

				<!-- Materials -->
				<section class="pb-20 lg:pb-24">
					<div class="container-custom">
						<div class="grid lg:grid-cols-[0.92fr_1.08fr] gap-10 xl:gap-14 items-start">
							<div class="capabilities-feature-panel">
								<span class="text-primary-500 font-semibold tracking-[0.2em] uppercase text-sm">{ content["capabilities.materials.eyebrow"] }</span>
								<h2 class="section-heading capabilities-section-heading mt-4">{ content["capabilities.materials.heading"] }</h2>
								<p class="mt-6 text-base md:text-lg text-secondary-700 leading-relaxed">
									{ content["capabilities.materials.body"] }
								</p>
							</div>
							<div class="grid sm:grid-cols-2 xl:grid-cols-3 gap-5">
								@materialCard("Tool Steels", []string{"P20", "H13", "S7", "A2", "D2", "O1", "420 SS"})
								@materialCard("Stainless Steels", []string{"303", "304", "316", "17-4 PH"})
								@materialCard("Aluminum", []string{"6061-T6", "7075-T6", "2024", "MIC-6"})
								@materialCard("Other Metals", []string{"Brass", "Bronze", "Copper", "Mild steel"})
								@materialCard("Plastics", []string{"Delrin / Acetal", "UHMW", "Nylon", "PEEK", "Acrylic"})
								@materialCard("File Formats", []string{"STEP", "IGES", "SolidWorks", "Parasolid", "DXF / DWG", "PDF"})
							</div>
						</div>
					</div>
				</section>

				<!-- Tolerances -->
				<section class="pb-24 lg:pb-28">
					<div class="container-custom">
						<div class="text-center mb-14 lg:mb-16">
							<span class="text-primary-500 font-semibold tracking-[0.2em] uppercase text-sm">{ content["capabilities.tolerances.eyebrow"] }</span>
							<h2 class="section-heading capabilities-section-heading mt-4">{ content["capabilities.tolerances.heading"] }</h2>
							<p class="mx-auto mt-6 max-w-2xl text-base md:text-lg text-secondary-700 leading-relaxed">
								{ content["capabilities.tolerances.body"] }
							</p>
						</div>
						<div class="grid md:grid-cols-3 gap-5 lg:gap-6 max-w-5xl mx-auto">
							@toleranceCard("Standard", "±0.005\"", "Unless otherwise specified")
							@toleranceCard("Precision", "±0.001\"", "Achievable on critical features")
							@toleranceCard("Surface Finish", "Various", "Based on requirements")
						</div>
					</div>
				</section>
			</div>
		</div>

		<!-- CTA -->
		<section class="relative min-h-[60vh] flex items-center overflow-hidden">
			<img src="/static/images/customer/sinker-edm-closeup.jpg" alt="Sinker EDM process in action" class="absolute inset-0 w-full h-full object-cover"/>
			<div class="absolute inset-0 bg-secondary-950/58"></div>
			<div class="container-custom relative z-10 text-center">
				<h2 class="font-display text-4xl md:text-6xl text-white uppercase mb-6">{ content["capabilities.cta.heading"] }</h2>
				<p class="text-white/78 text-lg mb-8 max-w-xl mx-auto leading-relaxed">
					{ content["capabilities.cta.body"] }
				</p>
				<a href="/contact" class="btn-primary">Request a Quote</a>
			</div>
		</section>
	}
}

templ capabilityCard(title string, items []string) {
	<div class="capabilities-card">
		<div class="mb-7 flex items-start justify-between gap-4">
			<h3 class="font-display text-[1.65rem] leading-none uppercase tracking-[0.06em] text-secondary-950">{ title }</h3>
			<span class="mt-1 h-3 w-3 shrink-0 rounded-full bg-primary-500 shadow-[0_0_0_6px_rgba(180,86,80,0.12)]"></span>
		</div>
		<ul class="space-y-4">
			for _, item := range items {
				<li class="flex items-center text-base md:text-lg text-secondary-700">
					<span class="w-2.5 h-2.5 bg-primary-500 rounded-full mr-4"></span>
					{ item }
				</li>
			}
		</ul>
	</div>
}

templ materialCard(title string, items []string) {
	<div class="capabilities-material-card">
		<h3 class="font-display text-xl md:text-2xl uppercase tracking-[0.08em] text-secondary-950 mb-5">{ title }</h3>
		<div class="flex flex-wrap gap-2.5">
			for _, item := range items {
				<span class="rounded-full border border-secondary-300 bg-white/80 px-3.5 py-2 text-sm font-medium text-secondary-700 shadow-sm">{ item }</span>
			}
		</div>
	</div>
}

templ toleranceCard(label, value, description string) {
	<div class="capabilities-tolerance-card">
		<div class="font-display text-5xl md:text-6xl text-primary-600 mb-3">{ value }</div>
		<div class="font-display text-xl text-secondary-950 uppercase tracking-[0.08em] mb-3">{ label }</div>
		<p class="text-secondary-700 text-sm md:text-base leading-relaxed">{ description }</p>
	</div>
}
