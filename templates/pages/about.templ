package pages

import (
	"rowetech/internal/meta"
	"rowetech/templates/layouts"
)

templ About() {
	@layouts.Base(meta.New("About", "Learn about RoweTech Machine & Engineering's story, values, and the industries we serve.")) {
		<!-- Hero -->
		<section class="relative min-h-[100svh] flex items-center overflow-hidden">
			<div class="absolute inset-0">
				<img src="https://images.unsplash.com/photo-1581092918056-0c4c3acd3789?w=1920&q=80" alt="Manufacturing" class="w-full h-full object-cover"/>
				<div class="absolute inset-0 bg-secondary-950/40"></div>
			</div>
			<div class="container-custom relative z-10 text-center">
				<h1 class="font-display text-5xl md:text-7xl lg:text-8xl text-white uppercase mb-6">About Us</h1>
				<p class="text-lg lg:text-xl text-white/80 max-w-xl mx-auto">
					A Wisconsin machine shop built on precision, integrity, and manufacturing excellence.
				</p>
			</div>
		</section>

		<!-- Story -->
		<section class="py-24 lg:py-32 bg-secondary-950 relative">
			<div class="container-custom">
				<div class="grid lg:grid-cols-2 gap-16 xl:gap-24 items-center">
					<div>
						<span class="text-primary-400 font-semibold tracking-[0.2em] uppercase text-sm">Our Story</span>
						<h2 class="section-heading mt-4 mb-6">Built on Experience</h2>
						<p class="text-secondary-200 text-lg leading-relaxed mb-8">
							RoweTech Machine & Engineering provides precision machining and tooling solutions from Cadott, Wisconsin. We serve plastic injection molding operations throughout the Midwest -- specializing in mold repair, custom fixtures, EOAT, and CNC machining. When your production is down, every hour matters, and fast turnaround is what we do.
						</p>
						<!-- Stats -->
						<div class="grid grid-cols-2 md:grid-cols-4 gap-6 pt-8 border-t border-secondary-800">
							@statItem("15+", "Years Experience")
							@statItem("500+", "Projects Completed")
							@statItem("48hr", "Quote Response")
							@statItem("100%", "Quality Focused")
						</div>
					</div>
					<div class="relative">
						<div class="aspect-[4/3] overflow-hidden">
							<img src="https://images.unsplash.com/photo-1504917595217-d4dc5ebe6122?w=800&q=80" alt="CNC Workshop" class="w-full h-full object-cover"/>
						</div>
					</div>
				</div>
			</div>
		</section>

		<!-- Values -->
		<section class="py-24 lg:py-32 bg-secondary-900 relative">
			<div class="container-custom">
				<div class="text-center mb-16">
					<h2 class="section-heading">Our Values</h2>
				</div>
				<div class="grid md:grid-cols-2 lg:grid-cols-4 gap-8">
					@valueCard("Quality Workmanship", "Every part we produce meets exacting standards. We take pride in precision.")
					@valueCard("Honest Communication", "Clear timelines, upfront pricing, and no surprises. We keep you informed.")
					@valueCard("Customer Focus", "Your success is our success. We work as an extension of your team.")
					@valueCard("Continuous Improvement", "We invest in our capabilities to better serve your evolving needs.")
				</div>
			</div>
		</section>

		<!-- CTA -->
		<section class="relative min-h-[60vh] flex items-center overflow-hidden">
			<img src="https://images.unsplash.com/photo-1504328345606-18bbc8c9d7d1?w=1920&q=80" alt="" class="absolute inset-0 w-full h-full object-cover"/>
			<div class="absolute inset-0 bg-secondary-950/50"></div>
			<div class="container-custom relative z-10 text-center">
				<h2 class="font-display text-4xl md:text-6xl text-white uppercase mb-6">Ready to Partner With Us?</h2>
				<p class="text-white/70 text-lg mb-8 max-w-xl mx-auto">
					Let's discuss how RoweTech can support your manufacturing needs.
				</p>
				<a href="/contact" class="btn-primary">Contact Us Today</a>
			</div>
		</section>
	}
}

templ statItem(value, label string) {
	<div class="text-center">
		<div class="font-display text-2xl md:text-3xl text-primary-500">{ value }</div>
		<div class="text-xs text-secondary-300 uppercase tracking-wider mt-1 font-medium">{ label }</div>
	</div>
}

templ valueCard(title, description string) {
	<div class="p-8 bg-secondary-950/30">
		<h3 class="font-display text-xl uppercase tracking-wide text-white mb-3">{ title }</h3>
		<p class="text-secondary-300">{ description }</p>
	</div>
}
