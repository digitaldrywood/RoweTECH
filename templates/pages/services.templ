package pages

import (
	"rowetech/internal/meta"
	"rowetech/templates/layouts"
)

templ Services() {
	@layouts.Base(meta.New("Services", "Precision machining, mold repair, and tooling services for manufacturers across Wisconsin.")) {
		<!-- Hero -->
		<section class="relative min-h-[100svh] flex items-center overflow-hidden">
			<div class="absolute inset-0">
				<img src="https://images.unsplash.com/photo-1504917595217-d4dc5ebe6122?w=1920&q=80" alt="CNC Machining" class="w-full h-full object-cover"/>
				<div class="absolute inset-0 bg-secondary-950/40"></div>
			</div>
			<div class="container-custom relative z-10 text-center">
				<h1 class="font-display text-5xl md:text-7xl lg:text-8xl text-white uppercase mb-6">Our Services</h1>
				<p class="text-lg lg:text-xl text-white/80 max-w-xl mx-auto">
					Machining and tooling solutions for manufacturers.
				</p>
			</div>
		</section>

		<!-- Services -->
		<section class="py-24 lg:py-32 bg-secondary-950">
			<div class="container-custom space-y-32">
				@serviceSection("mold-repair", "Plastic Injection Mold Repair", "Keep your production running with expert mold repair and maintenance services. We handle everything from minor repairs to major rebuilds.", "https://images.unsplash.com/photo-1581092918056-0c4c3acd3789?w=800&q=80", []string{"Weld repair and re-machining", "Insert replacement and modification", "Preventive maintenance programs"}, false)
				@serviceSection("fixtures", "Custom Fixtures & Tooling", "Precision-engineered workholding and inspection fixtures designed to improve your manufacturing efficiency and quality.", "https://images.unsplash.com/photo-1581091226825-a6a2a5aee158?w=800&q=80", []string{"Workholding and inspection fixtures", "Assembly fixtures and jigs", "Modifications and upgrades"}, true)
				@serviceSection("eoat", "EOAT Manufacturing", "End-of-Arm Tooling designed and built for your specific robotic automation needs.", "https://images.unsplash.com/photo-1565193566173-7a0ee3dbe261?w=800&q=80", []string{"Custom gripper assemblies", "Vacuum pickup plates", "Integration with existing robot systems"}, false)
				@serviceSection("cnc", "CNC Machining Services", "High-precision CNC milling and turning services for prototypes, short runs, and production quantities.", "https://images.unsplash.com/photo-1504917595217-d4dc5ebe6122?w=800&q=80", []string{"CNC milling and turning", "Surface grinding and EDM", "Prototype to production quantities"}, true)
			</div>
		</section>

		<!-- CTA -->
		<section class="relative min-h-[60vh] flex items-center overflow-hidden">
			<img src="https://images.unsplash.com/photo-1504328345606-18bbc8c9d7d1?w=1920&q=80" alt="" class="absolute inset-0 w-full h-full object-cover"/>
			<div class="absolute inset-0 bg-secondary-950/50"></div>
			<div class="container-custom relative z-10 text-center">
				<h2 class="font-display text-4xl md:text-6xl text-white uppercase mb-6">Need a Custom Solution?</h2>
				<p class="text-white/70 text-lg mb-8 max-w-xl mx-auto">
					Contact us to discuss your specific requirements.
				</p>
				<a href="/contact" class="btn-primary">Request a Quote</a>
			</div>
		</section>
	}
}

templ serviceSection(id, title, description, image string, details []string, reversed bool) {
	<div id={ id } class="scroll-mt-24">
		if reversed {
			<div class="grid lg:grid-cols-2 gap-12 lg:gap-16 items-center">
				<div class="order-2 lg:order-1">
					<h2 class="font-display text-3xl lg:text-4xl text-white uppercase mb-4">{ title }</h2>
					<p class="text-secondary-200 text-lg mb-8 leading-relaxed">{ description }</p>
					<ul class="space-y-3">
						for _, detail := range details {
							<li class="flex items-start">
								<svg class="w-5 h-5 text-primary-500 mr-3 mt-0.5 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
								</svg>
								<span class="text-secondary-200">{ detail }</span>
							</li>
						}
					</ul>
				</div>
				<div class="order-1 lg:order-2">
					<div class="aspect-[4/3] overflow-hidden">
						<img src={ image } alt={ title } class="w-full h-full object-cover"/>
					</div>
				</div>
			</div>
		} else {
			<div class="grid lg:grid-cols-2 gap-12 lg:gap-16 items-center">
				<div>
					<div class="aspect-[4/3] overflow-hidden">
						<img src={ image } alt={ title } class="w-full h-full object-cover"/>
					</div>
				</div>
				<div>
					<h2 class="font-display text-3xl lg:text-4xl text-white uppercase mb-4">{ title }</h2>
					<p class="text-secondary-200 text-lg mb-8 leading-relaxed">{ description }</p>
					<ul class="space-y-3">
						for _, detail := range details {
							<li class="flex items-start">
								<svg class="w-5 h-5 text-primary-500 mr-3 mt-0.5 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
								</svg>
								<span class="text-secondary-200">{ detail }</span>
							</li>
						}
					</ul>
				</div>
			</div>
		}
	</div>
}
